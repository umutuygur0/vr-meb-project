{
  "openapi": "3.0.4",
  "info": {
    "title": "VrChoiceApi",
    "version": "1.0"
  },
  "paths": {
    "/api/Choices": {
      "post": {
        "tags": [
          "Choices"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChoiceDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ChoiceDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ChoiceDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Choices/{userId}/{eventId}": {
      "get": {
        "tags": [
          "Choices"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChoiceDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "nullable": true
          },
          "eventId": {
            "type": "string",
            "nullable": true
          },
          "selectedOption": {
            "type": "integer",
            "format": "int32"
          },
          "selectedText": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Choices"
    }
  ]
}